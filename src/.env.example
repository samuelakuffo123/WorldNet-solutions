# PostgreSQL connection string (do not commit real credentials)
DATABASE_URL=postgresql://worldnet_user:change_me@localhost:5432/worldnet
# Set to true for managed cloud PostgreSQL services that require TLS.
DATABASE_SSL=false
# Port the server listens on. Overridden automatically by Render/Docker.
PORT=3000
# REQUIRED in production (>= 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production when this is missing or weak.
JWT_SECRET=replace-with-a-long-random-secret
# How long signed-in tokens last before the session expires (hours).
TOKEN_TTL_HOURS=8
# Comma-separated list of allowed browser origins. Leave empty to disable CORS
# for cross-origin browsers (same-origin app). When set, e.g.
#   CORS_ORIGINS=https://worldnet-solutions.onrender.com,https://admin.example.com
CORS_ORIGINS=
# Force Secure cookies even outside production (e.g. behind a TLS-terminating proxy).
# SECURE_COOKIES=true
# Where submitted report PDFs are stored on disk. Defaults to a temp directory.
# Persist this across restarts in production (e.g. /var/lib/worldnet/uploads).
# UPLOAD_DIR=./data/uploads
# Maximum PDF size, bytes (default 8 MB).
# REPORT_MAX_BYTES=8388608
# How long uploaded report files are kept before automatic deletion (days).
REPORT_RETENTION_DAYS=365
# Seed demo admin/worker accounts on first boot. Set to false in production so a
# fresh database has no accounts and the first-run setup screen creates the admin.
SEED_DEMO_DATA=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@worldnetict.com
# Google OAuth — client id for "Sign in with Google" (leave empty to hide the button).
GOOGLE_CLIENT_ID=
# Public URL of the app, used to build password-reset links (e.g. https://worldnet-solutions.onrender.com).
PUBLIC_BASE_URL=

# --- Production recommendation ----------------------------------------------
# NODE_ENV=production
# LOG_LEVEL=info